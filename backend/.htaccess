# backend/.htaccess
#
# Rewrites every /api/* request to index.php so the Router can dispatch it.
# Direct file requests (existing files, static assets) bypass the rewrite.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite real files / directories (CSS, JS, uploaded photos, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Forward Authorization header to PHP (some setups strip it)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Reasonable upload limits (override in php.ini for higher)
<IfModule mod_php.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 8M
</IfModule>

# Deny access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny access to .php files in subdirectories (only index.php is public)
<FilesMatch "\.php$">
    Require all granted
</FilesMatch>
<FilesMatch "(config|helpers|controllers|core|middleware)/.*\.php$">
    Require all denied
</FilesMatch>
